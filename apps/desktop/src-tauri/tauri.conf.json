{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Streamline",
  "version": "0.1.0",
  "identifier": "com.phillj26.streamline",
  "build": {
    "beforeDevCommand": "pnpm --dir ../web dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --dir ../web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Streamline",
        "width": 1280,
        "height": 800,
        "minWidth": 920,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https:; img-src 'self' https: data:; media-src 'self' https: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
