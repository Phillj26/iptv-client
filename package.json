{
  "name": "iptv-client",
  "version": "0.1.0",
  "private": true,
  "description": "A legal, cross-platform, local-first IPTV client.",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @streamline/web dev",
    "build": "pnpm --filter @streamline/core build && pnpm --filter @streamline/web build",
    "test": "pnpm --filter @streamline/core test && pnpm --filter @streamline/web test && node --test scripts/source-policy.test.mjs",
    "test:core": "pnpm --filter @streamline/core test",
    "typecheck": "pnpm --filter @streamline/core typecheck && pnpm --filter @streamline/web typecheck",
    "validate:sources": "node scripts/validate-sources.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm validate:sources",
    "android:sync": "pnpm build && pnpm --filter @streamline/android-tv sync",
    "android:open": "pnpm --filter @streamline/android-tv open",
    "desktop:dev": "pnpm --filter @streamline/desktop dev"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
